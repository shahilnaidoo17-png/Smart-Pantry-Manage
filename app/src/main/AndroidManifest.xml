<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No location / maps permissions: the app only deals with the user's own pantry. -->
    <application
        android:name=".SmartPantryApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantry">

        <activity android:name=".ui.PantryListActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.AddEditItemActivity" android:parentActivityName=".ui.PantryListActivity" />
        <activity android:name=".ui.SuggestedRecipesActivity" />
        <activity android:name=".ui.RecipeDetailActivity" android:parentActivityName=".ui.SuggestedRecipesActivity" />
        <activity android:name=".ui.SettingsActivity" />
    </application>
</manifest>
